{%- comment -%}
  Section: Sale endet bald (Countdown)
  Datei: sections/sale-countdown.liquid
  Benötigt zusätzlich: snippets/sale-countdown.liquid
{%- endcomment -%}

<div
  class="sale-countdown-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div
    style="
      {% unless section.settings.full_width %}max-width: {{ section.settings.max_width }}px;{% endunless %}
      margin-left: auto;
      margin-right: auto;
      padding-left: {% if section.settings.full_width %}0{% else %}16px{% endif %};
      padding-right: {% if section.settings.full_width %}0{% else %}16px{% endif %};
    "
  >
    {% render 'sale-countdown', s: section.settings, uid: section.id, product: product %}
  </div>
</div>

{% schema %}
{
  "name": "Sale endet bald",
  "tag": "section",
  "class": "sale-countdown-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon / Emoji",
      "default": "🔥",
      "info": "Leer lassen für kein Icon."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Sale endet bald!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Untertext",
      "default": "Sichere dir den Rabatt, bevor der Timer abläuft."
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Modus",
      "options": [
        { "value": "fixed", "label": "Festes Enddatum" },
        { "value": "evergreen", "label": "Pro Besucher (Evergreen)" }
      ],
      "default": "fixed",
      "info": "Evergreen: Jeder Besucher startet seinen eigenen Timer (im Browser gespeichert)."
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Enddatum (JJJJ-MM-TT)",
      "default": "2026-12-24",
      "info": "Nur für den Modus „Festes Enddatum“."
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "Endzeit (HH:MM)",
      "default": "23:59"
    },
    {
      "type": "select",
      "id": "utc_offset",
      "label": "Zeitzone",
      "options": [
        { "value": "Z", "label": "UTC" },
        { "value": "+01:00", "label": "UTC+1 (Deutschland, Winterzeit)" },
        { "value": "+02:00", "label": "UTC+2 (Deutschland, Sommerzeit)" },
        { "value": "+03:00", "label": "UTC+3" },
        { "value": "-05:00", "label": "UTC-5 (New York, Winter)" },
        { "value": "-08:00", "label": "UTC-8 (Los Angeles, Winter)" }
      ],
      "default": "+02:00"
    },
    {
      "type": "range",
      "id": "evergreen_hours",
      "label": "Evergreen-Dauer",
      "min": 1,
      "max": 72,
      "step": 1,
      "unit": "h",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_days",
      "label": "Tage anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_seconds",
      "label": "Sekunden anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "Label: Tage",
      "default": "Tage"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Label: Stunden",
      "default": "Std."
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "Label: Minuten",
      "default": "Min."
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "Label: Sekunden",
      "default": "Sek."
    },
    {
      "type": "select",
      "id": "on_expire",
      "label": "Wenn der Timer abgelaufen ist",
      "options": [
        { "value": "message", "label": "Hinweistext anzeigen" },
        { "value": "hide", "label": "Banner ausblenden" }
      ],
      "default": "message"
    },
    {
      "type": "text",
      "id": "expired_text",
      "label": "Text nach Ablauf",
      "default": "Diese Aktion ist beendet."
    },
    {
      "type": "header",
      "content": "Button (optional)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button-Text",
      "info": "Leer lassen, um den Button auszublenden."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button-Link"
    },
    {
      "type": "header",
      "content": "Anzeige-Bedingung"
    },
    {
      "type": "checkbox",
      "id": "only_if_on_sale",
      "label": "Nur anzeigen, wenn das Produkt reduziert ist",
      "default": false,
      "info": "Wirkt nur auf Produktseiten."
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Timer-Stil",
      "options": [
        { "value": "boxed", "label": "Kacheln" },
        { "value": "plain", "label": "Schlicht" }
      ],
      "default": "boxed"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Ausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Größe Überschrift",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Größe Ziffern",
      "min": 18,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Hintergrund Banner",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Hintergrund Ziffern-Kachel",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "box_text",
      "label": "Farbe Ziffern",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Hintergrund",
      "default": "#ff3b30"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button Text",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Rahmen anzeigen",
      "default": false
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Rahmenfarbe",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Ecken-Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Abschnitt"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Volle Breite",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximale Breite",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Sale endet bald"
    }
  ]
}
{% endschema %}
