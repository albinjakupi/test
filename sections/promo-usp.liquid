      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Link (optional)"
    },
    {
      "type": "select",
      "id": "promo_alignment",
      "label": "Ausrichtung",
      "default": "left",
