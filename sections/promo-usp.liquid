{%- comment -%}
  Section: Promo-Leiste + USP-Raster
  Datei: sections/promo-usp.liquid
  Benötigt zusätzlich: snippets/promo-usp.liquid und snippets/usp-icon.liquid
{%- endcomment -%}

<div
  class="promo-usp-wrapper"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div
    style="
      {% unless section.settings.full_width %}max-width: {{ section.settings.max_width }}px;{% endunless %}
      margin-left: auto;
      margin-right: auto;
      padding-left: {% if section.settings.full_width %}0{% else %}16px{% endif %};
      padding-right: {% if section.settings.full_width %}0{% else %}16px{% endif %};
    "
  >
    {% render 'promo-usp', s: section.settings, uid: section.id, blocks: section.blocks %}
  </div>
</div>

{% schema %}
{
