      "min": 0.8,
      "max": 2.5,
      "step": 0.1,
      "unit": "px",
      "default": 1.3
    },
    {
      "type": "range",
      "id": "icon_gap",
      "label": "Abstand Icon ↔ Text",
      "min": 6,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Spaltenabstand",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
