      "info": "Text zwischen **zwei Sternchen** wird fett dargestellt."
    },
    {
      "type": "checkbox",
      "id": "promo_uppercase",
      "label": "Fetten Anfang in GROSSBUCHSTABEN",
      "default": true
    },
    {
