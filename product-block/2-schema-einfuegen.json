          "min": 8,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 18
        },
        {
          "type": "range",
          "id": "promo_font_size",
          "label": "Schriftgröße",
          "min": 12,
          "max": 22,
          "step": 1,
          "unit": "px",
          "default": 15
        },
        {
          "type": "header",
          "content": "USP-Raster"
